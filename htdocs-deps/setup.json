{
	"build": {
		"common": [
			[ "symlinkCompress", "htdocs-deps/node_modules/jquery/dist/jquery.min.js", "htdocs/js/external/" ],
			[ "symlinkCompress", "htdocs-deps/node_modules/jquery/dist/jquery.min.map", "htdocs/js/external/" ],
			[ "symlinkCompress", "htdocs-deps/node_modules/zxcvbn/dist/zxcvbn.js", "htdocs/js/external/" ],
			[ "symlinkCompress", "htdocs-deps/node_modules/zxcvbn/dist/zxcvbn.js.map", "htdocs/js/external/" ],
			[ "symlinkCompress", "htdocs-deps/node_modules/chart.js/dist/chart.umd.min.js", "htdocs/js/external/" ],
			[ "symlinkCompress", "htdocs-deps/node_modules/chartjs-adapter-moment/dist/chartjs-adapter-moment.min.js", "htdocs/js/external/" ],

			[ "symlinkCompress", "htdocs-deps/node_modules/font-awesome/css/font-awesome.min.css", "htdocs/css/" ],
			[ "symlinkCompress", "htdocs-deps/node_modules/font-awesome/css/font-awesome.css.map", "htdocs/css/" ],
			[ "copyFiles", "htdocs-deps/node_modules/font-awesome/fonts/*", "htdocs/fonts/" ],

			[ "symlinkCompress", "htdocs-deps/node_modules/mdi/css/materialdesignicons.min.css", "htdocs/css/" ],
			[ "symlinkCompress", "htdocs-deps/node_modules/mdi/css/materialdesignicons.min.css.map", "htdocs/css/" ],
			[ "copyFiles", "htdocs-deps/node_modules/mdi/fonts/*", "htdocs/fonts/" ],

			[ "symlinkCompress", "htdocs-deps/node_modules/moment/min/moment.min.js", "htdocs/js/external/" ],
			[ "symlinkCompress", "htdocs-deps/node_modules/moment-timezone/builds/moment-timezone-with-data.min.js", "htdocs/js/external/" ],
			[ "symlinkCompress", "htdocs-deps/node_modules/jstimezonedetect/dist/jstz.min.js", "htdocs/js/external/" ],

			[ "symlinkFile", "htdocs-deps/node_modules/pixl-webapp/js", "htdocs/js/common" ],
			[ "symlinkFile", "htdocs-deps/node_modules/pixl-webapp/css/base.css", "htdocs/css/" ],
			[ "copyFiles", "htdocs-deps/node_modules/pixl-webapp/fonts/*", "htdocs/fonts/" ],

			[ "symlinkFile", "htdocs-deps/node_modules/socket.io-client/dist/socket.io.js", "htdocs/socket.io/" ],
			[ "symlinkFile", "htdocs-deps/node_modules/socket.io-client/dist/socket.io.js.map", "htdocs/socket.io/" ]
		],
		"dev": [
			[ "deleteFiles", "htdocs/css/_combo*" ],
			[ "deleteFiles", "htdocs/js/_combo*" ],
			[ "deleteFile", "htdocs/index.html" ],
			[ "deleteFile", "htdocs/index.html.gz" ],
			[ "symlinkFile", "htdocs/index-dev.html", "htdocs/index.html" ]
		],
		"dist": [
			[ "copyFile", "htdocs/index-dev.html", "htdocs/index.html" ],
			{
				"action": "bundleCompress",
				"uglify": false,
				"header": "/* OwlCron Frontend */",
				"dest_bundle": "htdocs/js/_combo.js",
				"html_file": "htdocs/index.html",
				"match_key": "COMBINE_SCRIPT",
				"dest_bundle_tag": "<script src=\"js/_combo.js\"></script>"
			},
			{
				"action": "bundleCompress",
				"strip_source_maps": true,
				"dest_bundle": "htdocs/css/_combo.css",
				"html_file": "htdocs/index.html",
				"match_key": "COMBINE_STYLE",
				"dest_bundle_tag": "<link rel=\"stylesheet\" href=\"css/_combo.css\">"
			}
		]
	}
}
